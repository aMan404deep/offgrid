# (Optional) Mapbox Public Access Token
# If configured, the app will use Mapbox geocoding for autocomplete; otherwise, it falls back to 100% free OpenStreetMap Nominatim.
VITE_MAPBOX_ACCESS_TOKEN=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GROQ_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------
# CLOUD SQL DATABASE (PostgreSQL / Supabase / Neon DB)
# ---------------------------------------------
# You can connect directly using a DATABASE_URL connection string:
DATABASE_URL="postgresql://neondb_owner:password@ep-host.us-east-1.aws.neon.tech/neondb?sslmode=require"

# (Fallback) Individual connection parameters:
SQL_HOST="aws-0-eu-central-1.pooler.supabase.com"
SQL_USER="postgres.your_supabase_project_id"
SQL_PASSWORD="your-supabase-db-password"
SQL_DB_NAME="postgres"

# (Optional) SUPABASE REST API KEYS (if you are querying from frontend instead of Drizzle backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-api-key"

# ---------------------------------------------
# NODEMAILER / SMTP EMAIL CONFIGURATION
# ---------------------------------------------
# To send actual OTP emails (instead of just logging to console):
# You can use a free service like Mailtrap, SendGrid, or Gmail App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="false" # false for 587, true for 465
SMTP_FROM="your-email@gmail.com"
